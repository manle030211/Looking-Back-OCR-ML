{
  "name": "ai-studio-angular-app",
  "version": "1.0.73",
  "main": "server.js",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@google/genai": "^2.4.0",
    "@types/jszip": "^3.4.1",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "marked": "^18.0.4",
    "mathml2omml": "^0.5.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/file-saver": "^2.0.7",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.5.0",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.aistudio.angularapp",
    "productName": "AI Studio Angular App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
